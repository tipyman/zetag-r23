<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="3pEmh2?N!Go;[XUhZ+R0" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="[^^rpOk2:T4_([KB#8!!"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace ZETag_R23 {" line1="    const txBuffer = pins.createBuffer(1);" line2="" line3="    /**" line4="     * Binary data transmission over UART" line5="     * @param TX_data: 8bit data" line6="    */" line7="    function UART_BIN_TX(txData: number): void {" line8="        txBuffer.setUint8(0, txData);" line9="        serial.writeBuffer(txBuffer)" line10="    }" line11="" line12="    /**" line13="     * Binary data reception over UART" line14="     * @param value: none" line15="     * @return value: 16bit data If return value is 256, reception time out." line16="    */" line17="    function UART_BIN_RX(): number {" line18="        const rxBuffer = serial.readBuffer(1)   // Bloking function (wait till receipt)" line19="        if (rxBuffer.length &gt; 0) {              // When receive data, alway length &gt; 0" line20="            return rxBuffer[0]" line21="        }" line22="        return 0;                               // Never come to this line." line23="    }" line24="" line25="    function receive_query(): number[] {" line26="        let response = [0, 0, 0, 0, 0, 0, 0, 0, 0]" line27="        let timeoutCounter = 0" line28="" line29="        while (true) {" line30="            const data = UART_BIN_RX();" line31="            if (data == 0xff) break;" line32="            timeoutCounter++;" line33="            if (timeoutCounter &gt; 15) return response; // Timeout" line34="        }" line35="" line36="        if (UART_BIN_RX() == 0) {   // FF 00 を待つ" line37="            response[0] = 0xff;" line38="            response[1] = 0x0;" line39="            let length = UART_BIN_RX();" line40="            if (length &gt; 6) length = 6;" line41="            response[2] = length;" line42="            let sum = 0xff + 0x00 + length" line43="            for (let i = 0; i &lt; length - 1; i++) {" line44="                const d = UART_BIN_RX() &amp; 0xff;" line45="                response[3 + i] = d;" line46="                sum += d;" line47="            }" line48="            const crc = UART_BIN_RX() &amp; 0xFF;" line49="            response[length + 2] = crc;   // Store CRC data to response" line50="            response = response.slice(0, length + 2); //omit redandant data" line51="            if ((sum &amp; 0xff) != crc) {" line52="                response = [3]" line53="            }" line54="        }" line55="        else response = [1];" line56="        if (response[3] == 0xff) {" line57="            response = [2]" line58="        }" line59="        return response" line60="    }" line61="" line62="    /**" line63="     * Send ZETag command execution" line64="     * @param txArray : number[]" line65="     * @param querySize: number" line66="     * @return queryData[]" line67="        queryData[0]:" line68="                0xff&#9;Query data is ready," line69="                   1    Time out error," line70="                   2&#9;Size error (Query size &lt;&gt; Receipt size)," line71="                   3    ZeTag error," line72="                   4    Checksum error," line73="                   5    Query data error" line74="       */" line75="    //% blockId=Send_ZETag_command block=&quot;Send ZETag command %txArray&quot;" line76="    //% group=&quot;Send data&quot; weight=95 blockGap=8" line77="    export function Send_ZETag_command(txArray: number[]): number[] {" line78="        const txArraySize = txArray.length" line79="        for (let l = 0; l &lt; txArraySize; l++) {" line80="            UART_BIN_TX(txArray[l])" line81="        }" line82="        let queryData = receive_query()" line83="        if ((queryData[3] == 0xf1) &amp;&amp; (txArray[3] == 0xf0)) {" line84="            return queryData" line85="        } else if (queryData[3] != txArray[3]) {" line86="            queryData[0] = 4" line87="        }" line88="        if (queryData[3] != txArray[3]) {" line89="            if ((queryData[3] != 0xf1) || (txArray[3] != 0xf0)) {" line90="                queryData[0] = 4" line91="            }" line92="        }" line93="        return queryData" line94="    }" line95="" line96="    /**" line97="     * send zetag application data" line98="     */" line99="    //% blockId=Transmit_ZETag_data block=&quot;Transmit ZETag data %dataArray&quot;" line100="    //% group=&quot;Send data&quot; weight=95 blockGap=8" line101="    export function Transmit_ZETag_data(txArray: number[]): void {" line102="        // 0xff+2+0x80=0x181 -&gt; 0x81" line103="        // Query FF 00 02 80 81" line104="        let num = txArray.length" line105="        if (num &lt; 1) return;" line106="        if (num &gt; 30) num = 30;" line107="        // 0xff+2+0x80=0x181 -&gt; 0x81  FF 00 02 80 xx xx xx" line108="        let checkSum = 0x81 + num" line109="        for (let m = 0; m &lt; num; m++) {" line110="            checkSum += txArray[m]" line111="        }" line112="        checkSum %= 256;" line113="        const header = [0xff, 0x00, num + 2, 0x80];" line114="        const response2 = Send_ZETag_command(header.concat(txArray).concat([checkSum]));" line115="    }" line116="" line117="" line118="    // --- 既存ロジック（そのまま利用） ---" line119="    /**" line120="     * set tx power" line121="     */" line122="    //% blockId=Set TX_Power block=&quot;Set TX Power %txPower (dB)&quot;" line123="    //% subcategory=&quot;Other&quot;" line124="    //% weight=95 blockGap=8" line125="    //% txPower.min=1 txPower.max=10 txPower.defl=10" line126="    export function Set_TX_Power(txPower: number): void {" line127="        if (txPower == 0) txPower = 1;" line128="        else if (txPower &gt;= 10) txPower = 10;" line129="" line130="        let txPowerData = txPower * 2" line131="        // FF 00 03 41 10 53; 出力8dB設定" line132="        // FF+00+03+41=0x143 -&gt; 0x43" line133="        // Query FF 00 02 41 42" line134="        const response4 = Send_ZETag_command([0xff, 0x00, 0x03, 0x41, txPowerData, (0x43 + txPowerData) % 256])" line135="    }" line136="" line137="    /**" line138="     * set channel spacing" line139="     */" line140="    //% blockId=set_channel_spacing block=&quot;Set channel spacing %chSpace (kHz)&quot;" line141="    //% subcategory=&quot;Other&quot;" line142="    //% weight=95 blockGap=8" line143="    //% chSpace.min=100 chSpace.max=200 chSpace.defl=100" line144="    export function Set_channel_spacing(chSpace: number): void {" line145="        // FF 00 03 F0 64 56; 100KHz設定" line146="        // FF+00+03+F0=1F2 -&gt; 0xf2" line147="        // Query FF 00 02 F1 F2" line148="        if (chSpace &lt;= 100) {" line149="            chSpace = 100" line150="        } else if (chSpace &gt;= 200) {" line151="            chSpace = 200" line152="        }" line153="        const response3 = Send_ZETag_command([0xff, 0x00, 0x03, 0xf0, chSpace, (0xf2 + chSpace) % 256]);" line154="    }" line155="" line156="    /**" line157="     * set transmission frequency" line158="     */" line159="    //% blockId=Set_Frequency block=&quot;Set Frequency %frequency (Hz) %chNum (ch) %chStep&quot;" line160="    //% subcategory=&quot;Other&quot;" line161="    //% weight=95 blockGap=8" line162="    //% frequency.min=470000000 frequency.max=928000000 frequency.defl=922080000" line163="    //% chNum.min=1 chNum.max=6 chNum.defl=2" line164="    //% chStep.min=1 chStep.max=2 chStep.defl=2" line165="    export function Set_Frequency(frequency: number, chNum: number, chStep: number): void {" line166="        // Query FF 00 02 40 41" line167="        if (chNum &lt;= 1) chNum = -1;" line168="        else if (chNum &gt;= 6) chNum = 6;" line169="" line170="        if (chStep == 0) chStep = 1;" line171="        else if (chStep &gt;= 2) chStep = 2;" line172="" line173="        if (frequency &lt; 470000000) frequency = 470000000;" line174="        else if (frequency &gt; 928000000) frequency = 928000000;" line175="        else if ((frequency &gt; 510000000) &amp;&amp; (frequency &lt; 920600000)) frequency = 510000000;" line176="" line177="        let txArray = [" line178="            0xff, 0x00, 0x08 + chNum, 0x40, 0x01," line179="            (frequency &gt;&gt; 24) &amp; 0xff," line180="            (frequency &gt;&gt; 16) &amp; 0xff," line181="            (frequency &gt;&gt; 8) &amp; 0xff," line182="            frequency &amp; 0xff," line183="            chNum, 0, 0, 0, 0, 0, 0, 0" line184="        ]" line185="        if (chNum &gt;= 2) {" line186="            for (let n = 0; n &lt; chNum; n++) {" line187="                txArray[10 + n] = n * chStep" line188="            }" line189="        } else {" line190="            txArray[4] = 0" line191="        }" line192="        let checkSum2 = 0" line193="        for (let o = 0; o &lt; chNum + 10; o++) {" line194="            checkSum2 += txArray[o]" line195="        }" line196="        checkSum2 %= 256" line197="        txArray[10 + chNum] = checkSum2" line198="" line199="        txArray = txArray.slice(0, 11 + chNum); // omit redundant data" line200="" line201="        const response5 = Send_ZETag_command(txArray)" line202="    }" line203="" line204="    /**" line205="     * set tx mode" line206="     */" line207="    //% blockId=Set TX_Mode block=&quot;Set TX Mode %txMode&quot;" line208="    //% subcategory=&quot;Other&quot;" line209="    //% weight=95 blockGap=8" line210="    //% txMode.defl=Mode.FSK4" line211="    export function Set_TX_Mode(txMode: number): void {" line212="        // FF 00 03 42 01 45; 4FSK mode" line213="        // FF 00 03 42 10 54; 8FSK mode" line214="        // Query FF 00 02 42 43" line215="        if (txMode === Mode.FSK4) {   // 4FSK" line216="            const response6 = Send_ZETag_command([0xff, 0x00, 0x03, 0x42, 0x01, 0x45])" line217="        } else {                    // 8FSK" line218="            const response62 = Send_ZETag_command([0xff, 0x00, 0x03, 0x42, 0x10, 0x54])" line219="        }" line220="    }" line221="" line222="    // --- UI 用の enum（ドロップダウン生成） ---" line223="    export enum ChSpace {" line224="        //% block=&quot;100&quot;" line225="        KHz100 = 100," line226="        //% block=&quot;200&quot;" line227="        KHz200 = 200" line228="    }" line229="    export enum ChNum {" line230="        //% block=&quot;1&quot;" line231="        _1 = 1," line232="        //% block=&quot;2&quot;" line233="        _2 = 2," line234="        //% block=&quot;3&quot;" line235="        _3 = 3," line236="        //% block=&quot;4&quot;" line237="        _4 = 4," line238="        //% block=&quot;5&quot;" line239="        _5 = 5," line240="        //% block=&quot;6&quot;" line241="        _6 = 6," line242="    }" line243="    export enum TxPower {" line244="        //% block=&quot;2&quot;" line245="        dBm2 = 2," line246="        //% block=&quot;4&quot;" line247="        dBm4 = 4," line248="        //% block=&quot;6&quot;" line249="        dBm6 = 6," line250="        //% block=&quot;8&quot;" line251="        dBm8 = 8," line252="        //% block=&quot;10&quot;" line253="        dBm10 = 10," line254="    }" line255="    export enum Mode {" line256="        //% block=&quot;4FSK&quot;" line257="        FSK4 = 0," line258="        //% block=&quot;8FSK&quot;" line259="        FSK8 = 1" line260="    }" line261="" line262="    // --- 4項目をまとめた設定ブロック（完成版） ---" line263="    /**" line264="     * ZETag の無線設定（周波数・帯域幅・チャンネル数・出力）をまとめて適用" line265="     */" line266="    //% blockId=zetag_setting" line267="    //% block=&quot;ZETag Setting|Frequency(Hz) %frequency|Band width(kHz) %chSpace|Number of Channel(ch) %chNum|Tx Power(dB) %txPower|Mode %mode&quot;" line268="    //% group=&quot;ZETag Setting&quot; weight=95 blockGap=8" line269="    //% frequency.min=470000000 frequency.max=928000000 frequency.defl=922080000" line270="    //% chSpace.defl=ChSpace.KHz200" line271="    //% chNum.defl=ChNum._2" line272="    //% txPower.defl=TxPower.dBm8" line273="    //% mode.defl=Mode.FSK4" line274="    export function applySetting(" line275="        frequency: number," line276="        chSpace: ChSpace," line277="        chNum: ChNum," line278="        txPower: TxPower," line279="        mode: Mode" line280="    ): void {" line281="        // 0) 変調方式の設定" line282="        Set_TX_Mode(mode)" line283="" line284="        // 1) 帯域幅の設定 いずれの設定でも100KHzにする" line285="        Set_channel_spacing(ChSpace.KHz100)" line286="" line287="        // 2) Tx 出力の設定" line288="        Set_TX_Power(txPower)" line289="" line290="        // 3) 周波数＋チャンネルの設定（Band width に応じて chStep を自動決定）" line291="        const chStep = (chSpace === ChSpace.KHz200) ? 2 : 1" line292="        Set_Frequency(frequency, chNum, chStep)" line293="    }" line294="}" numlines="295"></mutation></block></statement></block></xml>